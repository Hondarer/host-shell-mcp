# code-server release used by host-shell-code-server, shared by the Linux and Windows scripts.
# CODE_SERVER_VSCODE_VERSION is the VS Code version of that release ("Code" in its release notes);
# default extensions are resolved to versions compatible with it.
# The SHA-256 values are the digests of the GitHub Releases assets.
# CODE_SERVER_PORT set in the environment takes precedence over the value here.

CODE_SERVER_VERSION=4.144.0
CODE_SERVER_VSCODE_VERSION=1.144.0
CODE_SERVER_PORT=8000
CODE_SERVER_LINUX_AMD64_SHA256=710f749c40a0f3d0ab3be09c0de65314e5c2907cc50646f5fbc0f24c0e8fba2d
CODE_SERVER_LINUX_ARM64_SHA256=4404c784f541bd56a2a8d6e2a9474ed0b4e37bc8502aa3a247898ca933434482
CODE_SERVER_WINDOWS_AMD64_SHA256=324b7e31a2fb60c4e50202fdeae5e5cc5615878647973963874dea61d73ad9f7
